<div data-controller="modal">

  <button
    data-modal-target="default-modal"
    data-modal-toggle="default-modal"
    class="block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
    type="button">
    Create New Idea
  </button>

  <div
    id="default-modal"
    tabindex="-1"
    aria-hidden="true"
    class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">

    <div class="relative p-4 w-full max-w-2xl max-h-full">

      <div class="relative bg-white rounded-lg shadow">

        <%= simple_form_for Idea.new,
          data: {
            action: "turbo:submit-end->modal#hideModal"
          } do |f| %>

          <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t">
            <h3 class="text-xl font-semibold text-gray-900">
              Add New Idea
            </h3>

            <button
              type="button"
              class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 inline-flex justify-center items-center"
              data-modal-hide="default-modal">
              ✕
            </button>
          </div>

          <div class="p-4 md:p-5 space-y-4">
            <%= f.input :description %>
            <%= f.input :author %>
          </div>

          <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b gap-2">

            <%= f.submit "Submit",
              class: "text-white bg-blue-700 hover:bg-blue-800 px-5 py-2.5 rounded-lg" %>

            <button
              type="button"
              data-modal-hide="default-modal"
              class="py-2.5 px-5 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100">
              Cancel
            </button>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>

<div class="max-w-screen-xl mx-auto mt-6 space-y-4">

  <% @ideas.each do |idea| %>

    <div class="rounded shadow-lg p-6">

      <div class="font-bold text-xl mb-2">
        <%= idea.description %>
      </div>

      <p class="text-sm text-gray-700">
        <%= idea.author %>
      </p>

      <div class="flex gap-2 mt-4">

        <%= button_to "Delete",
          idea_path(idea),
          method: :delete,
          class: "text-white bg-red-600 px-4 py-2 rounded",
          form: { data: { turbo_confirm: "Are you sure?" } } %>

        <%= link_to "Revise",
          edit_idea_path(idea),
          class: "text-white bg-blue-600 px-4 py-2 rounded" %>

      </div>

    </div>

  <% end %>

</div>

<div class="max-w-screen-xl mx-auto mt-5 flex justify-center">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>