<div data-controller="modal">

  <!-- OPEN BUTTON -->
  <button
    type="button"
    data-action="click->modal#open"
    class="block text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5">
    Create New Idea
  </button>

  <!-- BACKDROP -->
  <div
    data-modal-target="backdrop"
    class="hidden fixed inset-0 bg-black/50 z-40">
  </div>

  <!-- MODAL -->
  <div
    data-modal-target="container"
    class="hidden fixed inset-0 z-50 flex items-center justify-center">

    <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl">

      <%= simple_form_for Idea.new,
        data: { action: "turbo:submit-end->modal#close" } do |f| %>

        <!-- HEADER -->
        <div class="flex justify-between items-center p-4 border-b">
          <h3 class="text-lg font-semibold">Add New Idea</h3>

          <button type="button"
            data-action="click->modal#close"
            class="text-gray-500 hover:text-black">
            ✕
          </button>
        </div>

        <!-- BODY -->
        <div class="p-4 space-y-4">
          <%= f.input :description %>
          <%= f.input :author %>
        </div>

        <!-- FOOTER -->
        <div class="flex justify-end gap-2 p-4 border-t">

          <%= f.submit "Submit",
            class: "bg-blue-700 text-white px-4 py-2 rounded" %>

          <button type="button"
            data-action="click->modal#close"
            class="px-4 py-2 border rounded">
            Cancel
          </button>

        </div>

      <% end %>

    </div>
  </div>

</div>

<div class="max-w-screen-xl mx-auto mt-6 space-y-4">

  <% @ideas.each do |idea| %>

    <div class="rounded shadow-lg p-6">

      <div class="font-bold text-xl mb-2">
        <%= idea.description %>
      </div>

      <p class="text-sm text-gray-700">
        <%= idea.author %>
      </p>

      <div class="flex gap-2 mt-4">

        <%= button_to "Delete",
          idea_path(idea),
          method: :delete,
          class: "text-white bg-red-600 px-4 py-2 rounded",
          form: { data: { turbo_confirm: "Are you sure?" } } %>

        <%= link_to "Revise",
          edit_idea_path(idea),
          class: "text-white bg-blue-600 px-4 py-2 rounded" %>

      </div>

    </div>

  <% end %>

</div>

<div class="max-w-screen-xl mx-auto mt-5 flex justify-center">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>